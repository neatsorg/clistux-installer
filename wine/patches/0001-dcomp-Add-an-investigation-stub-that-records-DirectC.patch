+
+static HRESULT device_create(IUnknown *rendering_device, REFIID iid, void **out)
+{
+    struct device *device;
+    HRESULT hr;
+
+    if (!out)
+        return E_POINTER;
+    *out = NULL;
+
+    if (!(device = calloc(1, sizeof(*device))))
+        return E_OUTOFMEMORY;
+    device->IDCompositionDesktopDevice_iface.lpVtbl = &device_vtbl;
+    device->refcount = 1;
+
+    hr = IDCompositionDesktopDevice_QueryInterface(&device->IDCompositionDesktopDevice_iface, iid, out);
+    IDCompositionDesktopDevice_Release(&device->IDCompositionDesktopDevice_iface);
+    return hr;
+}
+
 HRESULT WINAPI DCompositionCreateDevice(IDXGIDevice *dxgi_device, REFIID iid, void **device)
 {
     FIXME("%p, %s, %p.\n", dxgi_device, debugstr_guid(iid), device);
@@ -34,14 +600,18 @@ HRESULT WINAPI DCompositionCreateDevice(IDXGIDevice *dxgi_device, REFIID iid, vo
 
 HRESULT WINAPI DCompositionCreateDevice2(IUnknown *rendering_device, REFIID iid, void **device)
 {
-    FIXME("%p, %s, %p.\n", rendering_device, debugstr_guid(iid), device);
+    HRESULT hr = device_create(rendering_device, iid, device);
 
-    return E_NOTIMPL;
+    FIXME("rendering_device %s, iid %s, device %p -> hr %#lx, %p.\n",
+            debugstr_rendering_device(rendering_device), debugstr_guid(iid), device, hr, device ? *device : NULL);
+    return hr;
 }
 
 HRESULT WINAPI DCompositionCreateDevice3(IUnknown *rendering_device, REFIID iid, void **device)
 {
-    FIXME("%p, %s, %p.\n", rendering_device, debugstr_guid(iid), device);
+    HRESULT hr = device_create(rendering_device, iid, device);
 
-    return E_NOTIMPL;
+    FIXME("rendering_device %s, iid %s, device %p -> hr %#lx, %p.\n",
+            debugstr_rendering_device(rendering_device), debugstr_guid(iid), device, hr, device ? *device : NULL);
+    return hr;
 }
