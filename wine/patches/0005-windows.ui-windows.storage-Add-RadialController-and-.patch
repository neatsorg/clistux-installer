--- /dev/null
+++ b/dlls/windows.storage/storagefile.c
@@ -0,0 +1,197 @@
+/* WinRT Windows.Storage.StorageFile stub
+ *
+ * Copyright 2026 clistux contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * StorageFile is not implemented. Some applications (CLIP STUDIO PAINT, for menu icons of wheel devices)
+ * get the activation factory up front and crash when it is missing, but handle failing methods.
+ * This factory exists so that they can start: every IStorageFileStatics method returns E_NOTIMPL.
+ */
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(storage);
+
+static const GUID IID_IStorageFileStatics_stub =
+        {0x5984c710, 0xdaf2, 0x43c8, {0x8b, 0xb4, 0xa4, 0xd3, 0xea, 0xcf, 0xd0, 0x3f}};
+
+/* A statics/interop interface whose methods after IInspectable are stubs. */
+struct stub_interface
+{
+    const void *vtbl;
+    struct stub_factory *factory;
+    const GUID *iid;
+};
+
+struct stub_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    const WCHAR *class_name;
+    struct stub_interface interfaces[1];
+};
+
+#define STUB_METHODS 8
+
+static HRESULT WINAPI stub_method( void )
+{
+    return E_NOTIMPL;
+}
+
+static inline struct stub_factory *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct stub_factory, IActivationFactory_iface );
+}
+
+static HRESULT factory_query_interface( struct stub_factory *factory, REFIID iid, void **out )
+{
+    unsigned int i;
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = &factory->IActivationFactory_iface;
+        return S_OK;
+    }
+    for (i = 0; i < ARRAY_SIZE(factory->interfaces); ++i)
+    {
+        if (factory->interfaces[i].iid && IsEqualGUID( iid, factory->interfaces[i].iid ))
+        {
+            *out = &factory->interfaces[i];
+            return S_OK;
+        }
+    }
+
+    FIXME( "%s: %s not implemented, returning E_NOINTERFACE.\n",
+           debugstr_w(factory->class_name), debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static HRESULT WINAPI stub_interface_QueryInterface( struct stub_interface *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+    return factory_query_interface( iface->factory, iid, out );
+}
+
+static ULONG WINAPI stub_interface_AddRef( struct stub_interface *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI stub_interface_Release( struct stub_interface *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI stub_interface_GetIids( struct stub_interface *iface, ULONG *count, IID **iids )
+{
+    FIXME( "iface %p, count %p, iids %p stub!\n", iface, count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI stub_interface_GetRuntimeClassName( struct stub_interface *iface, HSTRING *name )
+{
+    return WindowsCreateString( iface->factory->class_name, wcslen( iface->factory->class_name ), name );
+}
+
+static HRESULT WINAPI stub_interface_GetTrustLevel( struct stub_interface *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+/* IInspectable methods followed by stubs. */
+static const void *stub_interface_vtbl[6 + STUB_METHODS] =
+{
+    stub_interface_QueryInterface,
+    stub_interface_AddRef,
+    stub_interface_Release,
+    stub_interface_GetIids,
+    stub_interface_GetRuntimeClassName,
+    stub_interface_GetTrustLevel,
+    stub_method, stub_method, stub_method, stub_method,
+    stub_method, stub_method, stub_method, stub_method,
+};
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct stub_factory *factory = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+    return factory_query_interface( factory, iid, out );
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids )
+{
+    FIXME( "iface %p, count %p, iids %p stub!\n", iface, count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    struct stub_factory *factory = impl_from_IActivationFactory( iface );
+    return WindowsCreateString( factory->class_name, wcslen( factory->class_name ), name );
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    struct stub_factory *factory = impl_from_IActivationFactory( iface );
+
+    FIXME( "%s: ActivateInstance not implemented.\n", debugstr_w(factory->class_name) );
+    *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+
+static struct stub_factory storage_file_factory =
+{
+    {&factory_vtbl},
+    L"Windows.Storage.StorageFile",
+    {
+        {stub_interface_vtbl, &storage_file_factory, &IID_IStorageFileStatics_stub},
+    },
+};
+
+IActivationFactory *storage_file_factory_stub = &storage_file_factory.IActivationFactory_iface;
