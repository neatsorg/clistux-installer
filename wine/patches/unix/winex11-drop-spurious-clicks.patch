--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -1556,6 +1556,26 @@
 /***********************************************************************
  *           X11DRV_ButtonPress
  */
+/* Some compositors (e.g. Hyprland) send an extra release and press, at the same time, while a pen is
+ * held down and the surface under it changes (for example when a menu opens under the pen). The extra
+ * press reopens or closes the menu. Drop a press that comes with a release of the same button at the
+ * same time and place, and the release that ends it. Enabled with WINE_X11_DROP_SPURIOUS_CLICKS=1. */
+static int spurious_button = -1;
+static Time last_release_time;
+static int last_release_button = -1, last_release_x, last_release_y;
+
+static BOOL drop_spurious_clicks(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        const char *env = getenv( "WINE_X11_DROP_SPURIOUS_CLICKS" );
+        enabled = env && *env == '1';
+    }
+    return enabled;
+}
+
 BOOL X11DRV_ButtonPress( HWND hwnd, XEvent *xev )
 {
     XButtonEvent *event = &xev->xbutton;
@@ -1567,6 +1587,14 @@
 
     TRACE( "hwnd %p/%lx button %u pos %d,%d\n", hwnd, event->window, buttonNum, event->x, event->y );
 
+    if (drop_spurious_clicks() && buttonNum == last_release_button && event->time - last_release_time <= 15 &&
+        abs( event->x_root - last_release_x ) <= 4 && abs( event->y_root - last_release_y ) <= 4)
+    {
+        TRACE( "dropping spurious press of button %u\n", buttonNum );
+        spurious_button = buttonNum;
+        return TRUE;
+    }
+
     input.mi.dx          = event->x;
     input.mi.dy          = event->y;
     input.mi.mouseData   = button_down_data[buttonNum];
@@ -1599,6 +1627,17 @@
 
     TRACE( "hwnd %p/%lx button %u pos %d,%d\n", hwnd, event->window, buttonNum, event->x, event->y );
 
+    if (buttonNum == spurious_button)
+    {
+        TRACE( "dropping release of the spurious press of button %u\n", buttonNum );
+        spurious_button = -1;
+        return TRUE;
+    }
+    last_release_button = buttonNum;
+    last_release_time = event->time;
+    last_release_x = event->x_root;
+    last_release_y = event->y_root;
+
     input.mi.dx          = event->x;
     input.mi.dy          = event->y;
     input.mi.mouseData   = button_up_data[buttonNum];
