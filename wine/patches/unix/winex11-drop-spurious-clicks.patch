--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -1553,6 +1553,45 @@
 }
 
 
+/* Some compositors (e.g. Hyprland) send an extra release and press, at the same time, while a pen is
+ * held down and the surface under it changes (for example when a menu opens under the pen). The extra
+ * press reopens or closes the menu. When WINE_X11_DROP_SPURIOUS_CLICKS=1 is set, drop a press that comes
+ * with a release of the same button within SPURIOUS_CLICK_TIME ms and SPURIOUS_CLICK_DIST pixels, and the
+ * release that ends it. A person can't release and press a button again that fast (a fast double click
+ * still takes tens of ms), so real clicks are kept. Wheel buttons have no release and are never dropped. */
+#define SPURIOUS_CLICK_TIME 15
+#define SPURIOUS_CLICK_DIST 4
+
+static struct
+{
+    BOOL dropped;   /* the last press was dropped, so drop the release that ends it */
+    BOOL released;  /* a release was seen */
+    Time time;      /* time of the last release */
+    int x, y;       /* root position of the last release */
+} last_button[NB_BUTTONS];
+
+static BOOL drop_spurious_clicks(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        const char *env = getenv( "WINE_X11_DROP_SPURIOUS_CLICKS" );
+        enabled = env && *env == '1';
+    }
+    return enabled;
+}
+
+static BOOL is_spurious_press( const XButtonEvent *event, int button )
+{
+    if (!drop_spurious_clicks() || !last_button[button].released) return FALSE;
+    /* the press must not come before the release (Time wraps around, so compare as signed) */
+    if ((long)(event->time - last_button[button].time) < 0) return FALSE;
+    if (event->time - last_button[button].time > SPURIOUS_CLICK_TIME) return FALSE;
+    return abs( event->x_root - last_button[button].x ) <= SPURIOUS_CLICK_DIST &&
+           abs( event->y_root - last_button[button].y ) <= SPURIOUS_CLICK_DIST;
+}
+
 /***********************************************************************
  *           X11DRV_ButtonPress
  */
@@ -1567,6 +1606,14 @@
 
     TRACE( "hwnd %p/%lx button %u pos %d,%d\n", hwnd, event->window, buttonNum, event->x, event->y );
 
+    last_button[buttonNum].dropped = is_spurious_press( event, buttonNum );
+    last_button[buttonNum].released = FALSE;
+    if (last_button[buttonNum].dropped)
+    {
+        TRACE( "dropping spurious press of button %u\n", buttonNum );
+        return TRUE;
+    }
+
     input.mi.dx          = event->x;
     input.mi.dy          = event->y;
     input.mi.mouseData   = button_down_data[buttonNum];
@@ -1599,6 +1646,17 @@
 
     TRACE( "hwnd %p/%lx button %u pos %d,%d\n", hwnd, event->window, buttonNum, event->x, event->y );
 
+    if (last_button[buttonNum].dropped)
+    {
+        TRACE( "dropping release of the spurious press of button %u\n", buttonNum );
+        last_button[buttonNum].dropped = FALSE;
+        return TRUE;
+    }
+    last_button[buttonNum].released = TRUE;
+    last_button[buttonNum].time = event->time;
+    last_button[buttonNum].x = event->x_root;
+    last_button[buttonNum].y = event->y_root;
+
     input.mi.dx          = event->x;
     input.mi.dy          = event->y;
     input.mi.mouseData   = button_up_data[buttonNum];
