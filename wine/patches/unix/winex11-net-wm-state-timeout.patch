+/* Some window managers (e.g. Hyprland with a rule suppressing maximize requests) silently ignore
+ * _NET_WM_STATE requests. Wine then waits for an answer forever and delays every config change, so
+ * the window can no longer be moved or resized. When WINE_X11_NET_WM_STATE_TIMEOUT is set (in ms),
+ * give up on a request that got no answer in time, and stop requesting the bits that were ignored.
+ * A window whose maximize request was ignored is then maximized by the Win32 side, with a config
+ * request for the maximized rect. */
+static DWORD net_wm_state_timeout(void)
+{
+    static int timeout = -1;
+
+    if (timeout == -1)
+    {
+        const char *env = getenv( "WINE_X11_NET_WM_STATE_TIMEOUT" );
+        timeout = env ? atoi( env ) : 0;
+        if (timeout < 0) timeout = 0;
+    }
+    return timeout;
+}
+
+static void window_request_desired_state( struct x11drv_win_data *data );
+
+static void check_net_wm_state_answer( struct x11drv_win_data *data )
+{
+    DWORD timeout = net_wm_state_timeout();
+    UINT ignored;
+
+    if (!timeout || !data->net_wm_state_serial) return;
+    if (NtGetTickCount() - data->net_wm_state_time < timeout) return;
+
+    ignored = data->pending_state.net_wm_state ^ data->current_state.net_wm_state;
+    WARN( "window %p/%lx, no answer to _NET_WM_STATE %#x serial %lu, giving up on %#x\n", data->hwnd,
+          data->whole_window, data->pending_state.net_wm_state, data->net_wm_state_serial, ignored );
+    data->net_wm_state_rejected |= ignored;
+    data->pending_state.net_wm_state = data->current_state.net_wm_state;
+    data->net_wm_state_serial = 0;
+
+    /* while waiting, the config requests of the maximized window kept its old size: ask for the
+     * maximized rect now, and send the other changes that were delayed */
+    if ((ignored & (1 << NET_WM_STATE_MAXIMIZED)) && (NtUserGetWindowLongW( data->hwnd, GWL_STYLE ) & WS_MAXIMIZE))
+        data->desired_state.rect = data->rects.visible;
+    window_request_desired_state( data );
+}
+
+/* The check above only runs when something happens to the window. If nothing does after the window
+ * manager ignored a request, the window would keep waiting (e.g. stay small after an ignored maximize
+ * at startup). Remember the waiting windows, and wake every thread up once the timeout has expired:
+ * each thread selects PropertyChangeMask on the root window, and checks its own windows in
+ * X11DRV_ProcessEvents. The wake-up is sent on gdi_display to the root window, which always exists. */
+static HWND net_wm_state_waiting[32];
+static LONG net_wm_state_waiting_count;
+static pthread_mutex_t net_wm_state_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static void *net_wm_state_wake_thread( void *arg )
+{
+    DWORD delay = (DWORD)(UINT_PTR)arg;
+    struct timespec ts = { delay / 1000, (delay % 1000) * 1000000 };
+    XEvent event;
+
+    nanosleep( &ts, NULL );
+    memset( &event, 0, sizeof(event) );
+    event.xproperty.type = PropertyNotify;
+    event.xproperty.window = DefaultRootWindow( gdi_display );
+    event.xproperty.atom = XInternAtom( gdi_display, "_WINE_NET_WM_STATE_TIMEOUT", False );
+    event.xproperty.state = PropertyNewValue;
+    XSendEvent( gdi_display, DefaultRootWindow( gdi_display ), False, PropertyChangeMask, &event );
+    XFlush( gdi_display );
+    return NULL;
+}
+
+static void wait_for_net_wm_state_answer( struct x11drv_win_data *data )
+{
+    DWORD timeout = net_wm_state_timeout();
+    pthread_attr_t attr;
+    pthread_t thread;
+    UINT i, slot = ARRAY_SIZE(net_wm_state_waiting);
+
+    data->net_wm_state_time = NtGetTickCount();
+    if (!timeout) return;
+
+    pthread_mutex_lock( &net_wm_state_mutex );
+    for (i = 0; i < ARRAY_SIZE(net_wm_state_waiting); i++)
+    {
+        if (net_wm_state_waiting[i] == data->hwnd) break;
+        if (!net_wm_state_waiting[i] && slot == ARRAY_SIZE(net_wm_state_waiting)) slot = i;
+    }
+    if (i == ARRAY_SIZE(net_wm_state_waiting) && slot < ARRAY_SIZE(net_wm_state_waiting))
+    {
+        net_wm_state_waiting[slot] = data->hwnd;
+        net_wm_state_waiting_count++;
+    }
+    pthread_mutex_unlock( &net_wm_state_mutex );
+
+    pthread_attr_init( &attr );
+    pthread_attr_setdetachstate( &attr, PTHREAD_CREATE_DETACHED );
+    if (pthread_create( &thread, &attr, net_wm_state_wake_thread, (void *)(UINT_PTR)(timeout + 50) ))
+        WARN( "failed to start the _NET_WM_STATE timeout thread\n" );
+    pthread_attr_destroy( &attr );
+}
+
+static void forget_net_wm_state_window( HWND hwnd )
+{
+    UINT i;
+
+    pthread_mutex_lock( &net_wm_state_mutex );
+    for (i = 0; i < ARRAY_SIZE(net_wm_state_waiting); i++)
+    {
+        if (net_wm_state_waiting[i] != hwnd) continue;
+        net_wm_state_waiting[i] = 0;
+        net_wm_state_waiting_count--;
+    }
+    pthread_mutex_unlock( &net_wm_state_mutex );
+}
+
+/* called from X11DRV_ProcessEvents: give up on the requests of this thread's windows that timed out */
+void check_net_wm_state_timeouts(void)
+{
+    HWND hwnds[ARRAY_SIZE(net_wm_state_waiting)], gone[ARRAY_SIZE(net_wm_state_waiting)];
+    struct x11drv_win_data *data;
+    DWORD tid = GetCurrentThreadId(), owner;
+    UINT i, count = 0, gone_count = 0;
+
+    if (!net_wm_state_waiting_count) return;
+
+    pthread_mutex_lock( &net_wm_state_mutex );
+    for (i = 0; i < ARRAY_SIZE(net_wm_state_waiting); i++)
+        if (net_wm_state_waiting[i]) hwnds[count++] = net_wm_state_waiting[i];
+    pthread_mutex_unlock( &net_wm_state_mutex );
+
+    for (i = 0; i < count; i++)
+    {
+        owner = NtUserGetWindowThread( hwnds[i], NULL );
+        if (!owner) gone[gone_count++] = hwnds[i];  /* the window is gone */
+        if (owner != tid) continue;
+        if ((data = get_win_data( hwnds[i] )))
+        {
+            check_net_wm_state_answer( data );
+            if (!data->net_wm_state_serial) gone[gone_count++] = hwnds[i];
+            release_win_data( data );
+        }
+        else gone[gone_count++] = hwnds[i];
+    }
+    for (i = 0; i < gone_count; i++) forget_net_wm_state_window( gone[i] );
+}
